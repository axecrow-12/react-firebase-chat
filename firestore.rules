rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function chatMembers(chatId) {
      // getAfter sees the chat even when it is created in the same batch.
      return getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Profiles: any signed in user can read them (needed to search for
    // people); only the owner can create or change their own.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.usernameLower == request.resource.data.username.lower();
    }

    // A chat between two people. Only its members can see or change it,
    // and its members and creation time can never change.
    match /chats/{chatId} {
      // Reading a chat that doesn't exist yet is allowed so the app can check.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Each user's chat list: one document per chat.
    match /userchats/{userId}/chats/{chatId} {
      // The owner can read and manage their own list.
      allow read, write: if signedIn() && request.auth.uid == userId;

      // The other person in a chat can add or update its entry in your list,
      // but only for a chat you are both members of.
      allow create, update: if signedIn()
        && request.resource.data.chatId == chatId
        && request.resource.data.receiverId == request.auth.uid
        && request.auth.uid in chatMembers(chatId)
        && userId in chatMembers(chatId);
    }
  }
}
